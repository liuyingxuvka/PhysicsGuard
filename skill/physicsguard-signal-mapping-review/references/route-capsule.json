{
  "schema_version": "physicsguard.skill_route_capsule.v1",
  "target_skill_id": "physicsguard-signal-mapping-review",
  "native_owner_id": "physicsguard.signal-mapping-review",
  "native_route_id": "route:physicsguard-signal-mapping-review:review",
  "route_role": "direct",
  "broad_route_prerequisite": false,
  "accept_when": [
    "The task concerns external-signal or parameter mapping identity, unit, conversion, confidence, review, timing, or staleness.",
    "Mapping evidence must be resolved before residual, adequacy, or predictive checks can use it."
  ],
  "reject_handoffs": [
    {
      "condition": "A concrete many-field test file first needs a complete field contract.",
      "target_skill_id": "physicsguard-test-file-contract-review"
    },
    {
      "condition": "Mappings are current and the task is exact model/dataset validation.",
      "target_skill_id": "physicsguard-model-dataset-validation"
    }
  ],
  "minimum_inputs": [
    "governed_signal_or_parameter",
    "target_variable",
    "unit_and_conversion_evidence",
    "revision_identity",
    "current_affected_interface_projection_when_present"
  ],
  "required_outputs": [
    "mapping_status",
    "review_gaps",
    "affected_slice_fingerprint_when_present",
    "downstream_blueprint_consumers_when_present",
    "temporal_boundary",
    "safe_mapping_claim"
  ],
  "initial_load": [
    "agents/openai.yaml",
    "SKILL.md",
    "references/route-capsule.json"
  ],
  "conditional_references": [
    {
      "path": "references/native-route-protocol.md",
      "load_when": [
        "route_selected_and_domain_execution_required",
        "blueprint_affected_interface_slice_required_when_present",
        "blueprint_reverse_trace_required_when_present"
      ],
      "required_for": [
        "target_native_domain_workflow",
        "blueprint_interface_mapping_projection_when_present"
      ],
      "sha256": "23b8c5ffe7cbc0a30ec0d0621ab2775d1b2c18b13fdac9d2bcd0d2d85474c105"
    },
    {
      "path": "references/native-depth-and-purpose.md",
      "load_when": [
        "create_task_local_model",
        "materially_deepen_model",
        "revise_candidate_model",
        "claim_model_closure"
      ],
      "required_for": [
        "execution_depth",
        "mapping",
        "residual",
        "uncertainty",
        "diagnosability",
        "predictive_rollout",
        "purpose_before_candidate",
        "prediction_before_observation",
        "model_miss",
        "typed_regression",
        "independent_holdout",
        "exact_terminal_boundary"
      ],
      "sha256": "bb1f9bea0b3c0eecdf39a5ec4ba9f4403a13631e4d9ee37a1b0b19b5978bc001"
    },
    {
      "path": "references/template-pack-routing.md",
      "load_when": [
        "select_template_pack",
        "preview_template_pack",
        "instantiate_template_pack",
        "validate_template_pack",
        "harvest_reusable_model"
      ],
      "required_for": [
        "validated_template_pack_routing"
      ],
      "sha256": "7bd5fad5614c7b7d232bb26fdc47c5df5c9a6db5170ac584a0ba04a9e94b4524"
    }
  ],
  "maximum_reference_depth": 1,
  "cross_skill_reference_loading": "typed_handoff_only",
  "entry_prompt_sha256": "704c8eebe64c200eba6f012ff5a436f37c12287ce46055cf77917b6de46e42bc",
  "claim_boundary": "A mapping pass licenses only the exact external signal, target variable, conversion, revision, temporal range, and reviewed confidence in the receipt."
}
