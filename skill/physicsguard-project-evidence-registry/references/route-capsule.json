{
  "schema_version": "physicsguard.skill_route_capsule.v1",
  "target_skill_id": "physicsguard-project-evidence-registry",
  "native_owner_id": "physicsguard.project-evidence-registry",
  "native_route_id": "route:physicsguard-project-evidence-registry:check",
  "route_role": "direct",
  "broad_route_prerequisite": false,
  "accept_when": [
    "One project's files, facts, bindings, bundles, and evidence gaps must be discovered or reconciled.",
    "An AI onboarding map or project-level evidence handoff is required."
  ],
  "reject_handoffs": [
    {
      "condition": "One concrete test file needs its field contract checked.",
      "target_skill_id": "physicsguard-test-file-contract-review"
    },
    {
      "condition": "The request is cross-project historical or database-ledger search.",
      "target_skill_id": "none"
    }
  ],
  "minimum_inputs": [
    "project_root",
    "declared_artifacts",
    "binding_expectations",
    "project_profile",
    "current_blueprint_summary_or_affected_slice"
  ],
  "required_outputs": [
    "reconciled_inventory",
    "binding_map",
    "affected_slice_fingerprint",
    "blueprint_binding_gaps",
    "critical_gaps",
    "closure_handoff"
  ],
  "initial_load": [
    "agents/openai.yaml",
    "SKILL.md",
    "references/route-capsule.json"
  ],
  "conditional_references": [
    {
      "path": "references/native-route-protocol.md",
      "load_when": [
        "route_selected_and_domain_execution_required",
        "blueprint_summary_required",
        "blueprint_affected_evidence_slice_required",
        "whole_boundary_handoff_required"
      ],
      "required_for": [
        "target_native_domain_workflow",
        "blueprint_evidence_binding_projection"
      ],
      "sha256": "48df602c5530e9124256e5290f2103c02cc383b3aec331c326377be7f873e208"
    },
    {
      "path": "references/native-depth-and-purpose.md",
      "load_when": [
        "create_task_local_model",
        "materially_deepen_model",
        "revise_candidate_model",
        "claim_model_closure"
      ],
      "required_for": [
        "execution_depth",
        "mapping",
        "residual",
        "uncertainty",
        "diagnosability",
        "predictive_rollout",
        "purpose_before_candidate",
        "prediction_before_observation",
        "model_miss",
        "typed_regression",
        "independent_holdout",
        "exact_terminal_boundary"
      ],
      "sha256": "bb1f9bea0b3c0eecdf39a5ec4ba9f4403a13631e4d9ee37a1b0b19b5978bc001"
    },
    {
      "path": "references/template-pack-routing.md",
      "load_when": [
        "select_template_pack",
        "preview_template_pack",
        "instantiate_template_pack",
        "validate_template_pack",
        "harvest_reusable_model"
      ],
      "required_for": [
        "validated_template_pack_routing"
      ],
      "sha256": "7bd5fad5614c7b7d232bb26fdc47c5df5c9a6db5170ac584a0ba04a9e94b4524"
    }
  ],
  "maximum_reference_depth": 1,
  "cross_skill_reference_loading": "typed_handoff_only",
  "entry_prompt_sha256": "a726ded8ac4af1bc8d6ad105af007f75bc0d9ccbd3ac763d45615ab7c7a05b6c",
  "claim_boundary": "Registry closure covers only the exact current project evidence bundle and declared roles/bindings; unresolved critical gaps or out-of-scope files remain blocking."
}
