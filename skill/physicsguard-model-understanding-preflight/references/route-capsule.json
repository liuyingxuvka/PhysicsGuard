{
  "schema_version": "physicsguard.skill_route_capsule.v1",
  "target_skill_id": "physicsguard-model-understanding-preflight",
  "native_owner_id": "physicsguard.model-understanding-preflight",
  "native_route_id": "route:physicsguard-model-understanding-preflight:review",
  "route_role": "direct",
  "broad_route_prerequisite": false,
  "accept_when": [
    "A non-trivial external model must be understood before residual interpretation or blueprint work.",
    "The physical boundary, inventory, assumptions, access gaps, semantics, or stop conditions need a current review."
  ],
  "reject_handoffs": [
    {
      "condition": "The request is only to resolve signal identity, unit, conversion, or confidence.",
      "target_skill_id": "physicsguard-signal-mapping-review"
    },
    {
      "condition": "A concrete test-data file needs field-level coverage first.",
      "target_skill_id": "physicsguard-test-file-contract-review"
    }
  ],
  "minimum_inputs": [
    "visible_symptom",
    "external_source_of_truth",
    "physical_boundary",
    "known_inventory"
  ],
  "required_outputs": [
    "preflight_status",
    "understanding_record",
    "access_gaps",
    "next_route"
  ],
  "initial_load": [
    "agents/openai.yaml",
    "SKILL.md",
    "references/route-capsule.json"
  ],
  "conditional_references": [
    {
      "path": "references/native-route-protocol.md",
      "load_when": [
        "route_selected_and_domain_execution_required"
      ],
      "required_for": [
        "target_native_domain_workflow"
      ],
      "sha256": "06afcb7e05aed4cebb5e4b1457e5337ca729e27b92685ae87fe5423aab3433ab"
    },
    {
      "path": "references/native-depth-and-purpose.md",
      "load_when": [
        "create_task_local_model",
        "materially_deepen_model",
        "revise_candidate_model",
        "claim_model_closure"
      ],
      "required_for": [
        "execution_depth",
        "mapping",
        "residual",
        "uncertainty",
        "diagnosability",
        "predictive_rollout",
        "purpose_before_candidate",
        "prediction_before_observation",
        "model_miss",
        "typed_regression",
        "independent_holdout",
        "exact_terminal_boundary"
      ],
      "sha256": "c5a58466be4429f3ee75f726a14c4295cb944e0d2454d65fe559d019a330afb2"
    },
    {
      "path": "references/template-pack-routing.md",
      "load_when": [
        "select_template_pack",
        "preview_template_pack",
        "instantiate_template_pack",
        "validate_template_pack",
        "harvest_reusable_model"
      ],
      "required_for": [
        "validated_template_pack_routing"
      ],
      "sha256": "bda75a6e981dd7ba46bee11cf5be39d665764bda7c21b462c3d619de0069377d"
    }
  ],
  "maximum_reference_depth": 1,
  "cross_skill_reference_loading": "typed_handoff_only",
  "entry_prompt_sha256": "d74b447377fb434f236831391e0ee07581f526f0798298c1227372db13baf7cb",
  "claim_boundary": "Preflight licenses only that the declared low-fidelity audit boundary is sufficiently understood to proceed; unresolved access or inventory gaps remain visible blockers."
}
