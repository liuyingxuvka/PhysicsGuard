{
  "schema_version": "physicsguard.skill_route_capsule.v1",
  "target_skill_id": "physicsguard-test-file-contract-review",
  "native_owner_id": "physicsguard.test-file-contract-review",
  "native_route_id": "route:physicsguard-test-file-contract-review:check",
  "route_role": "direct",
  "broad_route_prerequisite": false,
  "accept_when": [
    "One or more concrete testbench, test-data, log, sensor, command, measurement, calibration, or fixture files are in scope.",
    "File and field contracts must pass before broad AI analysis or dataset validation."
  ],
  "reject_handoffs": [
    {
      "condition": "No concrete test-data file is in scope.",
      "target_skill_id": "physicsguard-model-understanding-preflight"
    },
    {
      "condition": "Current file contracts pass and model/dataset consistency is now the request.",
      "target_skill_id": "physicsguard-model-dataset-validation"
    }
  ],
  "minimum_inputs": [
    "test_file",
    "testbench_profile",
    "field_inventory",
    "model_binding"
  ],
  "required_outputs": [
    "contract_status",
    "field_dispositions",
    "mapping_gaps",
    "safe_analysis_boundary"
  ],
  "initial_load": [
    "agents/openai.yaml",
    "SKILL.md",
    "references/route-capsule.json"
  ],
  "conditional_references": [
    {
      "path": "references/native-route-protocol.md",
      "load_when": [
        "route_selected_and_domain_execution_required"
      ],
      "required_for": [
        "target_native_domain_workflow"
      ],
      "sha256": "a21d63f69a6dab20e76a154218af5b5050fca1724f2d2ae26a888959f891bab0"
    },
    {
      "path": "references/native-depth-and-purpose.md",
      "load_when": [
        "create_task_local_model",
        "materially_deepen_model",
        "revise_candidate_model",
        "claim_model_closure"
      ],
      "required_for": [
        "execution_depth",
        "mapping",
        "residual",
        "uncertainty",
        "diagnosability",
        "predictive_rollout",
        "purpose_before_candidate",
        "prediction_before_observation",
        "model_miss",
        "typed_regression",
        "independent_holdout",
        "exact_terminal_boundary"
      ],
      "sha256": "972dc6a140dd17c462f1ef52b47f4cbc67cd6cf3f79fe3c5f63e8563a39a067b"
    },
    {
      "path": "references/template-pack-routing.md",
      "load_when": [
        "select_template_pack",
        "preview_template_pack",
        "instantiate_template_pack",
        "validate_template_pack",
        "harvest_reusable_model"
      ],
      "required_for": [
        "validated_template_pack_routing"
      ],
      "sha256": "bda75a6e981dd7ba46bee11cf5be39d665764bda7c21b462c3d619de0069377d"
    }
  ],
  "maximum_reference_depth": 1,
  "cross_skill_reference_loading": "typed_handoff_only",
  "entry_prompt_sha256": "40166bc8ad8e1da5b91b61f447f3d3ab669e650200d18ffcd33280447b490d13",
  "claim_boundary": "A pass covers only the exact test files, fields, units, timing, model/testbench versions, signal mappings, and depth represented in the receipt."
}
