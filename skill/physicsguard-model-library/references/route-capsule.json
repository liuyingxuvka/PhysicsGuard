{
  "schema_version": "physicsguard.skill_route_capsule.v1",
  "target_skill_id": "physicsguard-model-library",
  "native_owner_id": "physicsguard.model-library",
  "native_route_id": "route:physicsguard-model-library:reuse",
  "route_role": "direct",
  "broad_route_prerequisite": false,
  "accept_when": [
    "The task is to index validated model assets or decide whether one is reusable for a named target context.",
    "Asset, profile, testbench, validation, gap, or predictive-horizon compatibility must be checked."
  ],
  "reject_handoffs": [
    {
      "condition": "The asset has no current model/dataset validation receipt.",
      "target_skill_id": "physicsguard-model-dataset-validation"
    },
    {
      "condition": "The request is a cross-project database or historical-ledger query.",
      "target_skill_id": "none"
    }
  ],
  "minimum_inputs": [
    "asset_inventory",
    "target_context",
    "validation_receipts",
    "known_limits",
    "current_blueprint_fingerprint_and_projection"
  ],
  "required_outputs": [
    "compatible_assets",
    "reuse_status",
    "selected_blueprint_fingerprints",
    "verified_reuse_limits",
    "gaps",
    "bounded_reuse_scope"
  ],
  "initial_load": [
    "agents/openai.yaml",
    "SKILL.md",
    "references/route-capsule.json"
  ],
  "conditional_references": [
    {
      "path": "references/native-route-protocol.md",
      "load_when": [
        "route_selected_and_domain_execution_required",
        "blueprint_summary_for_discovery_required",
        "blueprint_affected_reuse_slice_required",
        "whole_target_reuse_qualification_required"
      ],
      "required_for": [
        "target_native_domain_workflow",
        "blueprint_reuse_compatibility_projection"
      ],
      "sha256": "787c6775e6398a0066354ccd7da1386f50f3eefc67ab65e7f788fc6b1e0eb55d"
    },
    {
      "path": "references/native-depth-and-purpose.md",
      "load_when": [
        "create_task_local_model",
        "materially_deepen_model",
        "revise_candidate_model",
        "claim_model_closure"
      ],
      "required_for": [
        "execution_depth",
        "mapping",
        "residual",
        "uncertainty",
        "diagnosability",
        "predictive_rollout",
        "purpose_before_candidate",
        "prediction_before_observation",
        "model_miss",
        "typed_regression",
        "independent_holdout",
        "exact_terminal_boundary"
      ],
      "sha256": "bb1f9bea0b3c0eecdf39a5ec4ba9f4403a13631e4d9ee37a1b0b19b5978bc001"
    },
    {
      "path": "references/template-pack-routing.md",
      "load_when": [
        "select_template_pack",
        "preview_template_pack",
        "instantiate_template_pack",
        "validate_template_pack",
        "harvest_reusable_model"
      ],
      "required_for": [
        "validated_template_pack_routing"
      ],
      "sha256": "7bd5fad5614c7b7d232bb26fdc47c5df5c9a6db5170ac584a0ba04a9e94b4524"
    }
  ],
  "maximum_reference_depth": 1,
  "cross_skill_reference_loading": "typed_handoff_only",
  "entry_prompt_sha256": "46ef52e4e5d6a425e9fc0f2eeff40befd6c021c2a66547a3186441ecdc6953c5",
  "claim_boundary": "Library readiness licenses only the selected asset/profile/testbench combination and exact bounded reuse scope; it does not validate a new project automatically."
}
