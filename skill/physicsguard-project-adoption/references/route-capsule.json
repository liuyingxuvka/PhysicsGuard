{
  "schema_version": "physicsguard.skill_route_capsule.v1",
  "target_skill_id": "physicsguard-project-adoption",
  "native_owner_id": "physicsguard.project-adoption",
  "native_route_id": "route:physicsguard-project-adoption:audit",
  "route_role": "direct",
  "broad_route_prerequisite": false,
  "accept_when": [
    "The task is to check, create, or upgrade PhysicsGuard repository adoption records.",
    "Current toolchain, artifact inventory, blockers, or affected revalidation must be established."
  ],
  "reject_handoffs": [
    {
      "condition": "The project is adopted and the task is to map its files and evidence gaps.",
      "target_skill_id": "physicsguard-project-evidence-registry"
    },
    {
      "condition": "The user asks whether a model result is validated or complete.",
      "target_skill_id": "physicsguard-audit-closure"
    }
  ],
  "minimum_inputs": [
    "project_root",
    "project_record",
    "runtime_identity"
  ],
  "required_outputs": [
    "adoption_status",
    "toolchain_status",
    "blockers",
    "required_revalidation"
  ],
  "initial_load": [
    "agents/openai.yaml",
    "SKILL.md",
    "references/route-capsule.json"
  ],
  "conditional_references": [
    {
      "path": "references/native-route-protocol.md",
      "load_when": [
        "route_selected_and_domain_execution_required"
      ],
      "required_for": [
        "target_native_domain_workflow"
      ],
      "sha256": "1b9b48bae3f2b2ad44fb88e2c5b0f80df545acfd96319fbac3bbf1f20d1b29dc"
    },
    {
      "path": "references/native-depth-and-purpose.md",
      "load_when": [
        "create_task_local_model",
        "materially_deepen_model",
        "revise_candidate_model",
        "claim_model_closure"
      ],
      "required_for": [
        "execution_depth",
        "mapping",
        "residual",
        "uncertainty",
        "diagnosability",
        "predictive_rollout",
        "purpose_before_candidate",
        "prediction_before_observation",
        "model_miss",
        "typed_regression",
        "independent_holdout",
        "exact_terminal_boundary"
      ],
      "sha256": "48c7c43211021b3acd3601ebe37b8e75f22476e42bf76dad307faf811ba481be"
    },
    {
      "path": "references/template-pack-routing.md",
      "load_when": [
        "select_template_pack",
        "preview_template_pack",
        "instantiate_template_pack",
        "validate_template_pack",
        "harvest_reusable_model"
      ],
      "required_for": [
        "validated_template_pack_routing"
      ],
      "sha256": "bda75a6e981dd7ba46bee11cf5be39d665764bda7c21b462c3d619de0069377d"
    }
  ],
  "maximum_reference_depth": 1,
  "cross_skill_reference_loading": "typed_handoff_only",
  "entry_prompt_sha256": "282043acc00d98297950b2ba2d3875e1b673977f6db97ca7be9357b73446fc9d",
  "claim_boundary": "Adoption proves only current workflow records and toolchain/artifact readiness; it never substitutes for model execution, validation, closure, installation, or release evidence."
}
