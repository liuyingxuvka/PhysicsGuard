{
  "schema_version": "physicsguard.skill_route_capsule.v1",
  "target_skill_id": "physicsguard-candidate-model-blueprint",
  "native_owner_id": "physicsguard.candidate-model-blueprint",
  "native_route_id": "route:physicsguard-candidate-model-blueprint:build",
  "route_role": "direct",
  "broad_route_prerequisite": false,
  "accept_when": [
    "The user asks for initial target inventory or a candidate blueprint draft, including explicit evidence gaps.",
    "The user requests full blueprint review or target-model generation eligibility from current validated PhysicsGuard evidence."
  ],
  "reject_handoffs": [
    {
      "condition": "Understanding or validation work is requested as its own task, rather than drafting or reviewing the blueprint.",
      "target_skill_id": "physicsguard-model-understanding-preflight"
    },
    {
      "condition": "Dataset validation evidence must be produced before a generation-eligibility claim.",
      "target_skill_id": "physicsguard-model-dataset-validation"
    }
  ],
  "minimum_inputs": [
    "authoring_target",
    "available_hierarchy_and_inventory",
    "current_blueprint_when_present",
    "blueprint_artifact_root_if_reviewing",
    "explicit_material_root_if_declared",
    "validated_hierarchy_if_claiming_generation_eligibility",
    "current_native_validation_if_claiming_generation_eligibility",
    "interface_inventory_when_available",
    "model_semantics_when_known",
    "in_memory_projection_if_requested",
    "in_memory_selector_if_requested"
  ],
  "required_outputs": [
    "candidate_blueprint",
    "physical_blueprint_review_if_requested",
    "blueprint_fingerprint_when_present",
    "material_root_disposition",
    "native_execution_status",
    "deepest_licensed_layer",
    "first_gap",
    "safe_claim",
    "native_directory_dna_status",
    "in_memory_query_identity_and_gaps_if_requested",
    "execution_claim_licensed",
    "generation_eligibility",
    "rollout_boundary",
    "blockers"
  ],
  "initial_load": [
    "agents/openai.yaml",
    "SKILL.md",
    "references/route-capsule.json"
  ],
  "conditional_references": [
    {
      "path": "references/native-route-protocol.md",
      "load_when": [
        "route_selected_and_domain_execution_required",
        "blueprint_summary_required",
        "blueprint_affected_slice_required",
        "blueprint_author_or_full_review_required",
        "explicit_material_root_or_fmi_observation_required",
        "in_memory_blueprint_projection_query_required"
      ],
      "required_for": [
        "target_native_domain_workflow",
        "canonical_physical_blueprint_authority",
        "in_memory_physical_blueprint_projection"
      ],
      "sha256": "f9028e057a5bedf68685a6dee10b0ff2ce995c3f41f5305cfab946d4ff2f37e6"
    },
    {
      "path": "references/native-depth-and-purpose.md",
      "load_when": [
        "create_task_local_model",
        "materially_deepen_model",
        "revise_candidate_model",
        "claim_model_closure"
      ],
      "required_for": [
        "execution_depth",
        "mapping",
        "residual",
        "uncertainty",
        "diagnosability",
        "predictive_rollout",
        "purpose_before_candidate",
        "prediction_before_observation",
        "model_miss",
        "typed_regression",
        "independent_holdout",
        "exact_terminal_boundary"
      ],
      "sha256": "bb1f9bea0b3c0eecdf39a5ec4ba9f4403a13631e4d9ee37a1b0b19b5978bc001"
    },
    {
      "path": "references/template-pack-routing.md",
      "load_when": [
        "select_template_pack",
        "preview_template_pack",
        "instantiate_template_pack",
        "validate_template_pack",
        "harvest_reusable_model"
      ],
      "required_for": [
        "validated_template_pack_routing"
      ],
      "sha256": "7bd5fad5614c7b7d232bb26fdc47c5df5c9a6db5170ac584a0ba04a9e94b4524"
    }
  ],
  "maximum_reference_depth": 1,
  "cross_skill_reference_loading": "typed_handoff_only",
  "entry_prompt_sha256": "3a43f11c3ffb4e78f52404fdf5a29ebe59be5f3d3fb88ede6d67c78344e562ed",
  "claim_boundary": "Generation eligibility covers only a candidate low-fidelity blueprint for the declared target and interfaces; it is not an implemented or validated high-fidelity model."
}
