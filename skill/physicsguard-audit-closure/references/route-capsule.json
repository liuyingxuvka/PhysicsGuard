{
  "schema_version": "physicsguard.skill_route_capsule.v1",
  "target_skill_id": "physicsguard-audit-closure",
  "native_owner_id": "physicsguard.audit-closure",
  "native_route_id": "route:physicsguard-audit-closure:close",
  "route_role": "direct",
  "broad_route_prerequisite": false,
  "accept_when": [
    "The requested outcome is a final audit, localization, validation, reuse, handoff, or prediction-readiness claim.",
    "Current native results must be reconciled into passed, partial, downgraded, or blocked closure."
  ],
  "reject_handoffs": [
    {
      "condition": "Evidence is still being generated or the physical fault is still being localized.",
      "target_skill_id": "physicsguard-ai-debugging"
    },
    {
      "condition": "The request is only to build the project evidence map.",
      "target_skill_id": "physicsguard-project-evidence-registry"
    }
  ],
  "minimum_inputs": [
    "requested_claim",
    "closure_plan",
    "native_receipts",
    "open_blockers",
    "current_whole_or_affected_blueprint_review",
    "current_execution_receipts_if_claimed"
  ],
  "required_outputs": [
    "closure_status",
    "safe_claim",
    "blueprint_scope_fingerprint",
    "blueprint_depth_and_first_gap",
    "in_memory_projection_identity",
    "in_memory_query_status",
    "current_execution_status",
    "execution_claim_licensed",
    "blockers",
    "next_actions"
  ],
  "initial_load": [
    "agents/openai.yaml",
    "SKILL.md",
    "references/route-capsule.json"
  ],
  "conditional_references": [
    {
      "path": "references/native-route-protocol.md",
      "load_when": [
        "route_selected_and_domain_execution_required",
        "blueprint_affected_closure_required",
        "blueprint_whole_boundary_closure_required",
        "in_memory_blueprint_projection_closure_required"
      ],
      "required_for": [
        "target_native_domain_workflow",
        "blueprint_closure_projection",
        "in_memory_blueprint_projection_claim_boundary"
      ],
      "sha256": "fe07f80390bb27c0397bb7653e42999b72a5c61c4c8427f2b4d85b8f888576f0"
    },
    {
      "path": "references/native-depth-and-purpose.md",
      "load_when": [
        "create_task_local_model",
        "materially_deepen_model",
        "revise_candidate_model",
        "claim_model_closure"
      ],
      "required_for": [
        "execution_depth",
        "mapping",
        "residual",
        "uncertainty",
        "diagnosability",
        "predictive_rollout",
        "purpose_before_candidate",
        "prediction_before_observation",
        "model_miss",
        "typed_regression",
        "independent_holdout",
        "exact_terminal_boundary"
      ],
      "sha256": "bb1f9bea0b3c0eecdf39a5ec4ba9f4403a13631e4d9ee37a1b0b19b5978bc001"
    },
    {
      "path": "references/template-pack-routing.md",
      "load_when": [
        "select_template_pack",
        "preview_template_pack",
        "instantiate_template_pack",
        "validate_template_pack",
        "harvest_reusable_model"
      ],
      "required_for": [
        "validated_template_pack_routing"
      ],
      "sha256": "7bd5fad5614c7b7d232bb26fdc47c5df5c9a6db5170ac584a0ba04a9e94b4524"
    }
  ],
  "maximum_reference_depth": 1,
  "cross_skill_reference_loading": "typed_handoff_only",
  "entry_prompt_sha256": "bfc9ce35f9125e460a03505ad65802aa536488629ddc003d4f9cdf124cbe68e1",
  "claim_boundary": "Closure proves only the exact requested audit scope represented by current native receipts; skipped, stale, partial, and predictive gaps remain non-pass."
}
