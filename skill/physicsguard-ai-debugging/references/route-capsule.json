{
  "schema_version": "physicsguard.skill_route_capsule.v1",
  "target_skill_id": "physicsguard-ai-debugging",
  "native_owner_id": "physicsguard.ai-debugging",
  "native_route_id": "route:physicsguard-ai-debugging:audit",
  "route_role": "composite",
  "broad_route_prerequisite": false,
  "accept_when": [
    "The visible engineering fault spans several PhysicsGuard responsibilities and cannot be owned by one direct route.",
    "The correct PhysicsGuard route remains genuinely ambiguous after comparing the ten route capsules.",
    "Coarse-to-fine localization requires typed handoffs among preflight, mapping, validation, and closure owners."
  ],
  "reject_handoffs": [
    {
      "condition": "Repository adoption or upgrade is the whole request.",
      "target_skill_id": "physicsguard-project-adoption"
    },
    {
      "condition": "External-model boundary and inventory understanding is the whole request.",
      "target_skill_id": "physicsguard-model-understanding-preflight"
    },
    {
      "condition": "Signal identity, units, conversion, confidence, or temporal mapping is the whole request.",
      "target_skill_id": "physicsguard-signal-mapping-review"
    },
    {
      "condition": "A concrete test-data file contract is the whole request.",
      "target_skill_id": "physicsguard-test-file-contract-review"
    },
    {
      "condition": "Exact model/dataset validation is the whole request.",
      "target_skill_id": "physicsguard-model-dataset-validation"
    },
    {
      "condition": "Project evidence inventory and binding gaps are the whole request.",
      "target_skill_id": "physicsguard-project-evidence-registry"
    },
    {
      "condition": "Reusable model asset compatibility is the whole request.",
      "target_skill_id": "physicsguard-model-library"
    },
    {
      "condition": "Candidate blueprint generation is the whole request.",
      "target_skill_id": "physicsguard-candidate-model-blueprint"
    },
    {
      "condition": "Audit completion or localization closure is the whole request.",
      "target_skill_id": "physicsguard-audit-closure"
    }
  ],
  "minimum_inputs": [
    "visible_symptom",
    "physical_boundary_or_gap",
    "route_ambiguity",
    "current_blueprint_summary_affected_or_reverse_trace"
  ],
  "required_outputs": [
    "selected_native_routes",
    "localized_findings",
    "blueprint_trace_projection",
    "delegated_blueprint_owner",
    "next_required_evidence",
    "bounded_claim"
  ],
  "initial_load": [
    "agents/openai.yaml",
    "SKILL.md",
    "references/route-capsule.json"
  ],
  "conditional_references": [
    {
      "path": "references/native-route-protocol.md",
      "load_when": [
        "route_selected_and_domain_execution_required",
        "blueprint_summary_for_route_selection_required",
        "blueprint_affected_or_reverse_trace_required"
      ],
      "required_for": [
        "target_native_domain_workflow",
        "blueprint_mixed_route_coordination"
      ],
      "sha256": "38b729586afa23551ab2dc6553182604995a94973c7dd39209ce60352b402216"
    },
    {
      "path": "references/native-depth-and-purpose.md",
      "load_when": [
        "create_task_local_model",
        "materially_deepen_model",
        "revise_candidate_model",
        "claim_model_closure"
      ],
      "required_for": [
        "execution_depth",
        "mapping",
        "residual",
        "uncertainty",
        "diagnosability",
        "predictive_rollout",
        "purpose_before_candidate",
        "prediction_before_observation",
        "model_miss",
        "typed_regression",
        "independent_holdout",
        "exact_terminal_boundary"
      ],
      "sha256": "25109387b07ef75cc255d11226eaee3d349a1cd2a1467dde82ffb6a90e703ee2"
    },
    {
      "path": "references/template-pack-routing.md",
      "load_when": [
        "select_template_pack",
        "preview_template_pack",
        "instantiate_template_pack",
        "validate_template_pack",
        "harvest_reusable_model"
      ],
      "required_for": [
        "validated_template_pack_routing"
      ],
      "sha256": "bda75a6e981dd7ba46bee11cf5be39d665764bda7c21b462c3d619de0069377d"
    }
  ],
  "maximum_reference_depth": 1,
  "cross_skill_reference_loading": "typed_handoff_only",
  "entry_prompt_sha256": "255a8ca0b2248116113e36b6ced846a6622cff1598102a03a2af162fd415312d",
  "claim_boundary": "This route can license only a low-fidelity, evidence-bounded fault localization. It does not prove high-fidelity model truth or behavior outside the checked operating envelope."
}
